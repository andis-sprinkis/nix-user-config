#!/usr/bin/env sh

# User environment variables in systemd and dbus

systemctl --user set-environment "XDG_CURRENT_DESKTOP=sway"
systemctl --user import-environment "DISPLAY" "SWAYSOCK" "XDG_CURRENT_DESKTOP" "WAYLAND_DISPLAY"
dbus-update-activation-environment --systemd "DISPLAY" "SWAYSOCK" "XDG_CURRENT_DESKTOP=sway" "WAYLAND_DISPLAY"

# xdg-desktop-portal

systemctl --user restart "xdg-desktop-portal.service"

# gsettings

"${XDG_CONFIG_HOME:-$HOME/.config}/gsettings/init"

# .Xresources

## xrdb

xrdb -retain -load "${XDG_CONFIG_HOME:-$HOME/.config}/xresources/.Xresources"

pathf_xresources_local="${XDG_CONFIG_HOME:-$HOME/.config}/xresources/local.Xresources"

if [ -f "$pathf_xresources_local" ]; then
  xrdb -retain -override "$pathf_xresources_local"
fi

## xsettingsd

"${XDG_DATA_HOME:-$HOME/.local/share}/xsettingsd/init" &

# swayidle, swaylock

idle_manager "start" &

# Starting VirtualBox guest service

VBoxClient-all &

# Notification-daemon
if ! pidof -q "dunst"; then
  dunst &
fi

# Polkit authentication agent

if ! pidof -q "polkit-gnome-authentication-agent-1"; then
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# EeasyEffects audio effects interface

if ! pidof -q "easyeffects"; then
  easyeffects --service-mode &
fi

# foot terminal server

foot --server &

# Local settings

pathf_post_init_local="${XDG_CONFIG_HOME:-$HOME/.config}/sway/post_init_local"

if [ -f "$pathf_post_init_local" ]; then
  exec "$pathf_post_init_local"
fi
