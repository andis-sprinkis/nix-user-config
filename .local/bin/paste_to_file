#!/usr/bin/env sh
set -euf

if [ -z "$*" ]; then
  echo "$(basename "$0"): No path specified"

  exit "1"
fi

if [ "${WAYLAND_DISPLAY:-""}" ] && command -v "wl-paste" 1> "/dev/null" 2> "/dev/null"; then
  exec wl-paste >> "$@"
fi

if [ "${DISPLAY:-""}" ] && [ -z "${WAYLAND_DISPLAY:-""}" ] && command -v "xclip" 1> "/dev/null" 2> "/dev/null"; then
  exec xclip -o -sel "clipboard" >> "$@"
fi

if command -v "pbcopy" 1> "/dev/null" 2> "/dev/null"; then
  exec pbpaste >> "$@"
fi

exit "1"
