#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

task="$1" cmd="$2"

shift "2"

case "$task" in
  "exec"|"exec_wait")
    shell_task="shell"

    if [ "$task" = "exec_wait" ]; then shell_task="shell_wait"; fi

    fp_files=""

    if [ "$#" != "0" ]; then
      fp_files="$(mktemp)"

      while [ "$#" != "0" ]; do
        echo "$1" >> "$fp_files"
        shift
      done
    fi

    exec $TERMINAL -e \
      "/usr/bin/env" "sh" "-c" "terminal_shell_cmd ${shell_task} \"${cmd}\"${fp_files:+" \"${fp_files}\""}"
  ;;
  "shell"|"shell_wait")
    fp_files="${1:-""}"

    if [ "$fp_files" ]; then
      cat "$fp_files" | {
        set --

        IFS=" "
        for arg in $cmd; do
          IFS="$IFS_"

          set -- "$@" "$arg"
        done
        IFS="$IFS_"

        IFS="$NL"
        while read -r f; do
          IFS="$IFS_"

          set -- "$@" "$f"
        done
        IFS="$IFS_"

        set +e; rm "$fp_files"; set -e;

        case "$task" in
          "shell")
            exec env "$@"
          ;;
          "shell_wait")
            set +e
            env "$@"
            echo "(${?}) Press any key to exit"
            set -e
            IFS= read -r "_" < "/dev/tty"
          ;;
        esac
      }
    else
      IFS=" "
      for arg in $cmd; do
        IFS="$IFS_"

        set -- "$@" "$arg"
      done
      IFS="$IFS_"

      case "$task" in
        "shell")
          exec "$@"
        ;;
        "shell_wait")
          set +e
          env "$@"
          echo "(${?}) Press any key to exit"
          set -e
          IFS= read -r "_" < "/dev/tty"
        ;;
      esac
    fi
  ;;
  *)
    exit "3"
  ;;
esac
