#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

exit_usage() {
  script="$(basename "$0")"
  msg_usage="${script} [-a ACTION] [-t TARGET] [-d DELAY] [-i AUDIO]
${script} -h

Options:
ACTION screenshot|record|stop (Default: screenshot)
TARGET all|area|output|output_focused|window|window_focused|workspace|workspace_focused (Default: area)
DELAY  <integer seconds> (Default: 0)
AUDIO  true|false (Default: false)

Examples:
${script} -a screenshot -t window -d 5  Capture screenshot of the selected window after 5s
${script} <No options>|-a screenshot    Same as '${script} -a screenshot -t area -d 0'
${script} -a record                     Same as '${script} -a record -t area -d 0 -i false'
${script} -a stop                       Stop recording video
${script} -h                            Print this message"

  echo "$msg_usage" 1>&2

  exit "${1:-"0"}"
}

action="screenshot"
target="area"
delay="0"
audio="false"

OPTIND="1"
while getopts "a:t:d:i:h" opt; do
  case "$opt" in
    "a")
      action="$OPTARG"
    ;;
    "t")
      target="$OPTARG"
    ;;
    "d")
      delay="$OPTARG"
    ;;
    "i")
      audio="$OPTARG"
    ;;
    "h")
      exit_usage
    ;;
    *)
      exit_usage "1"
    ;;
  esac
done

path_dir="${HOME}/scr"

exit_no_display_server() {
  exec echo "no_display_server"
}

display_server=""

if [ "${WAYLAND_DISPLAY:-""}" ]; then display_server="wayland"; fi

if [ "${DISPLAY:-""}" ] && [ -z "${WAYLAND_DISPLAY:-""}" ]; then display_server="x11"; fi

if [ -z "$display_server" ]; then exit_no_display_server; fi

i3blocks_signal() {
  if [ "${1:-""}" = "wait" ]; then sleep "1"; fi

  if pidof -q "i3blocks"; then pkill "-SIGRTMIN+7" -x "i3blocks"; fi
}

# shellcheck disable=SC3044
exit_saved() {
  i3blocks_signal 1>/dev/null 2>/dev/null & disown
  exec echo "saved ${path_out}"
}

# shellcheck disable=SC3044
exit_stopped() {
  i3blocks_signal 1>/dev/null 2>/dev/null & disown
  exec echo "stopped"
}

# shellcheck disable=SC3044
exit_canceled() {
  i3blocks_signal 1>/dev/null 2>/dev/null & disown
  exec echo "canceled"
}

# shellcheck disable=SC3044
exit_failed() {
  i3blocks_signal 1>/dev/null 2>/dev/null & disown
  exec echo "failed"
}

# shellcheck disable=SC3044
exit_no_audio_device() {
  i3blocks_signal 1>/dev/null 2>/dev/null & disown
  exec echo "no_audio_device"
}

exit_area_selection_in_progress() {
  exec echo "area_selection_in_progress"
}

exit_not_implemented() {
  exec echo "not_implemented"
}

exit_no_area_selected() {
  exec echo "no_area_selected"
}

# shellcheck disable=SC3044
countdown() {
  while [ "$delay" -gt "0" ]; do
    delay="$((delay - 1))"

    sleep "1"

    echo "$delay"
  done

  i3blocks_signal "wait" 1>/dev/null 2>/dev/null & disown
}

ptr_coord_output() {
  set +e
  swaymsg -t "get_outputs" | jq -r ".. | select(.active?).rect | ${jq_rect_map}" | slurp 2>&1
  set -e
  return "0"
}

ptr_coord_output_focused() {
  set +e
  swaymsg -t "get_outputs" | jq -r ".. | select(.focused?).rect | ${jq_rect_map}"
  set -e
  return "0"
}

ptr_coord_window() {
  set +e
  swaymsg -t "get_tree" | jq -r ".. | select(.pid? and .visible?).rect | ${jq_rect_map}" | slurp 2>&1
  set -e
  return "0"
}

ptr_coord_window_focused() {
  set +e
  swaymsg -t "get_tree" | jq -j ".. | select(.type? and .focused?).rect | ${jq_rect_map}"
  set -e
  return "0"
}

ptr_coord_workspace() {
  set +e
  swaymsg -t "get_workspaces" | jq -r ".. | select(.visible? and .type == \"workspace\").rect | ${jq_rect_map}" | slurp 2>&1
  set -e
  return "0"
}

ptr_coord_workspace_focused() {
  set +e
  swaymsg -t "get_workspaces" | jq -r ".. | select(.focused? and .type == \"workspace\").rect | ${jq_rect_map}"
  set -e
  return "0"
}

ptr_coord=""
jq_rect_map='"\(.x),\(.y) \(.width)x\(.height)"'

case "$action" in
  "stop")
    # shellcheck disable=SC3044
    case "$display_server" in
      "wayland")
        set +e
        pkill -SIGINT -x "wf-recorder"
        pkill -SIGINT -x "slurp"
        set -e

        exit_stopped
      ;;
      "x11")
        exit_not_implemented
      ;;
    esac
  ;;
  "record")
    path_out="${path_dir}/$(date "+%s").mp4"

    mkdir -p "$path_dir"

    case "$target" in
      "all"|"area"|"output"|"output_focused"|"window"|"window_focused"|"workspace"|"workspace_focused")
        case "$display_server" in
          "wayland")
            if pidof -q "wf-recorder" || pidof -q "slurp"; then exit "3"; fi

            case "$target" in
              "all")
                exit_not_implemented
              ;;
              "area")
                ptr_coord="$(set +e; slurp 2>&1; set -e)"
              ;;
              "output")
                ptr_coord="$(ptr_coord_output)"
              ;;
              "output_focused")
                ptr_coord="$(ptr_coord_output_focused)"
              ;;
              "window")
                ptr_coord="$(ptr_coord_window)"
              ;;
              "window_focused")
                ptr_coord="$(ptr_coord_window_focused)"
              ;;
              "workspace")
                ptr_coord="$(ptr_coord_workspace)"
              ;;
              "workspace_focused")
                ptr_coord="$(ptr_coord_workspace_focused)"
              ;;
            esac

            if [ -z "$ptr_coord" ]; then no_area_selected; fi

            if [ "$ptr_coord" = "selection cancelled" ]; then canceled; fi

            set -- "wf-recorder" --codec="libx264rgb" --geometry="$ptr_coord" --file="$path_out"

            if [ "$audio" = "true" ]; then
              set +e; audio_dev="$(pactl get-default-sink)"; set -e;

              if [ -z "$audio_dev" ]; then exit_no_audio_device; fi

              set -- "$@" --audio="${audio_dev}.monitor"
            fi

            countdown

            if ! "$@"; then exit_failed; fi

            exit_saved
          ;;
          "x11")
            exit_not_implemented
          ;;
        esac
      ;;
      "-h"|"--help")
        exit_usage
      ;;
      *)
        exit_usage "1"
      ;;
    esac
  ;;
  "screenshot")
    path_out="${path_dir}/$(date "+%s").png"

    mkdir -p "$path_dir"

    case "$display_server" in
      "wayland")
        if pidof -q "grim" || pidof -q "dulcepan"; then exit_area_selection_in_progress; fi

        case "$target" in
          "all")
            countdown

            if ! grim "$path_out"; then exit_failed; fi

            exit_saved
          ;;
          "area")
            countdown

            set +e
            dulcepan_stderr="$(dulcepan -f "png" -o "$path_out" 2>&1)"
            dulcepan_exit="$?"
            set -e

            if [ "$dulcepan_exit" != "0" ]; then
              if [ -z "$dulcepan_stderr" ]; then exit_canceled; fi

              if [ "$dulcepan_stderr" = "[FATAL] The selection is empty" ]; then exit_no_area_selected; fi

              exit_failed
            fi

            exit_saved
          ;;
          "output")
            ptr_coord="$(ptr_coord_output)"
          ;;
          "output_focused")
            ptr_coord="$(ptr_coord_output_focused)"
          ;;
          "window")
            ptr_coord="$(ptr_coord_window)"
          ;;
          "window_focused")
            ptr_coord="$(ptr_coord_window_focused)"
          ;;
          "workspace")
            ptr_coord="$(ptr_coord_workspace)"
          ;;
          "workspace_focused")
            ptr_coord="$(ptr_coord_workspace_focused)"
          ;;
          *)
            exit_usage "1"
          ;;
        esac

        if [ -z "$ptr_coord" ]; then no_area_selected; fi

        if [ "$ptr_coord" = "selection cancelled" ]; then exit_canceled; fi

        countdown

        if ! grim -g "$ptr_coord" "$path_out"; then exit_failed; fi

        exit_saved
      ;;
      "x11")
        case "${target:-""}" in
          "all")
            if ! maim -d "$delay" -u "$path_out"; then exit_failed; fi

            exit_saved
          ;;
          "area")
            if ! maim -d "$delay" -u --select "$path_out"; then exit_failed; fi

            exit_saved
          ;;
          "output")
            # prompt to use pointer coordinates to select the output ?
            #
            # if ! maim -d "$delay" -u -g "..." "$path_out"; then
            #   exit_failed
            # fi
            #
            # exit_saved

            exit_not_implemented
          ;;
          "output_focused")
            mouseloc="$(xdotool "getmouselocation")"

            m_x="${mouseloc##x:}"
            m_x="${m_x%% *}"

            m_y="${mouseloc##*y:}"
            m_y="${m_y%% *}"

            outputs="$(set +e; xrandr | grep " connected "; set -e)"

            o_coords=""

            IFS="$NL"
            for o in $outputs; do
              IFS="$IFS_"

              # o_name="${o%%" "*}"

              o_coords="${o##*" connected "}"
              o_coords="${o_coords##"primary "}"
              o_coords="${o_coords%%" "*}"

              o_width="${o_coords%%"x"*}"

              o_height="${o_coords##*"x"}"
              o_height="${o_height%%"+"*}"

              o_x_offset="${o_coords##"${o_width}x${o_height}+"}"
              o_x_offset="${o_x_offset%%"+"*}"

              o_y_offset="${o_coords##"${o_width}x${o_height}+${o_x_offset}+"}"

              if   [ "$m_x" -ge "$o_x_offset" ] \
                && [ "$m_x" -le "$((o_width + o_x_offset))" ] \
                && [ "$m_y" -ge "$o_y_offset" ] \
                && [ "$m_y" -le "$((o_height + o_y_offset))" ]
              then
                break
              fi
            done
            IFS="$IFS_"

            if ! maim -d "$delay" -u -g "$o_coords" "$path_out"; then exit_failed; fi

            exit_saved
          ;;
          "window")
            # see i3_get_win_criteria
            # window_id="$(xwininfo -int | sed -nre "s/^xwininfo: Window id: (${match_int}) .*$/\1/p")"
            #
            # if ! maim -d "$delay" -u --window "..." "$path_out"; then
            #   exit_failed
            # fi
            #
            # exit_saved

            exit_not_implemented
          ;;
          "window_focused")
            if ! maim -d "$delay" -u --window "$(xdotool "getactivewindow")" "$path_out"; then exit_failed; fi

            exit_saved
          ;;
          "workspace")
            # prompt to use pointer coordinates to select the workspace ?
            # query i3 for the focused workspace geometry ?
            #
            # if ! maim -d "$delay" -u -g "..." "$path_out"; then
            #   exit_failed
            # fi
            #
            # exit_saved

            exit_not_implemented
          ;;
          "workspace_focused")
            # xdotool get_desktop_for_window ?
            # query i3 for the focused workspace geometry ?
            #
            # if ! maim -d "$delay" -u -g "..." "$path_out"; then
            #   exit_failed
            # fi
            #
            # exit_saved

            exit_not_implemented
          ;;
          *)
            exit_usage "1"
          ;;
        esac
      ;;
    esac
  ;;
  *)
    exit_usage "1"
  ;;
esac
