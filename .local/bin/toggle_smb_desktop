#!/usr/bin/env sh
set -euf

if systemctl is-active --quiet "smb"; then
  exec $TERMINAL -e "/usr/bin/env" "sh" "-c" "printf \"\033]0;%s\007\" \"Stop SMB service\"; systemctl stop smb; read"
fi

exec $TERMINAL -e "/usr/bin/env" "sh" "-c" "printf \"\033]0;%s\007\" \"Start SMB service\"; systemctl start smb; read"
