#!/usr/bin/env sh
set -euf

if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/htop/htoprc_common" ]; then
  set +e
  cat "${XDG_CONFIG_HOME:-$HOME/.config}/htop/htoprc_common" > "${XDG_CONFIG_HOME:-$HOME/.config}/htop/htoprc"
  set -e
fi

# shellcheck disable=SC3028
case "${OSTYPE:-"$(uname)"}" in
  [dD]"arwin"*)
    exec "${BREW_PREFIX:-"/opt/homebrew"}/bin/htop" "$@"
  ;;
  *)
    exec "/usr/bin/htop" "$@"
  ;;
esac
