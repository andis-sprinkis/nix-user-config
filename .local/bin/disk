#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

help_info() {
  script="$(basename "$0")"

  echo "NAME
    ${script} - Show disk utilization.

SYNOPSIS
    ${script} [-f]

DESCRIPTION
    Shows disk utilization.

    -f
        Shows utilization for all devices (including all of the 'tmpfs', 'efivarf', 'run', 'dev').

    -h
        Prints this message."
}

opt_f=""
while getopts "fh" "name"; do
  case "$name" in
    "f")
      opt_f="1"
    ;;
    "h")
      help_info
      exit
    ;;
    "?")
      help_info 1>&2
      exit "2"
    ;;
  esac
done

export LC_ALL="C"

fmt_reset="\x1b[0m" fmt_sever="\x1b[0;32m" fmt_mute="\x1b[0;90m"

human() {
  scl="$((
    $1 < 1024 ? 1 :
      $1 < 1048576 ? 1024 :
        $1 < 1073741824 ? 1048576 :
          $1 < 1099511627776 ? 1073741824 :
            $1 < 1125899906842624 ? 1099511627776 :
              0
  ))"

  case "$scl" in
    "1") unit="K" ;;
    "1024") unit="M" ;;
    "1048576") unit="G" ;;
    "1073741824") unit="T" ;;
    "1099511627776") unit="P" ;;
  esac

  ans="$((($1 * 10) / scl))"
  ans="${ans%[0-9]}.${ans#"${ans%[0-9]}"}"
  echo "${ans%.0}${unit}"
}

path_rev() {
  fp="$1" suf_rev=""

  case "$1" in
    "//"*"/"*)
      fp="${1#"//"*"/"}"

      suf="${1%"$fp"}"
      suf="${suf#"//"}"
      suf="${suf%"/"}"

      suf_rev="$(printf '%s\n' "$suf" | sed -e 's|\.|\.\n|g' | {
        rev=""

        IFS=""
        while read -r "i"; do
          IFS="$IFS_"

          case "$i" in
            *".")
              rev=".${i%%.}${rev}"
            ;;
            *)
              rev="${i}${rev}"
            ;;
          esac
        done
        IFS="$IFS_"

        printf '\%s\\\\\n' "$rev"
      })"
    ;;
    *"@"*":/"*)
      fp="${1#*"@"*":"}"
      suf="${1%":${fp}"}"

      suf_rev="$(printf '%s\n' "$suf" | sed -e 's|\([@.]\)|\1\n|g' | {
        rev=""

        IFS=""
        while read -r "i"; do
          IFS="$IFS_"

          case "$i" in
            *".")
              rev=".${i%%.}${rev}"
            ;;
            *"@")
              rev="@${i%%@}${rev}"
            ;;
            *)
              rev="${i}${rev}"
            ;;
          esac
        done
        IFS="$IFS_"

        printf ':%s\n' "$rev"
      })"
    ;;
  esac

  printf '%s\n' "$fp" | sed -e 's|/|/\n|g' | {
    rev=""

    IFS=""
    while read -r "i"; do
      IFS="$IFS_"

      case "$i" in
        "/")
          rev="\\${rev}"
        ;;
        *"/")
          rev="\\${i%%/}${rev}"
        ;;
        *)
          rev="${i}${rev}"
        ;;
      esac
    done
    IFS="$IFS_"

    printf '%s\n' "${rev}${suf_rev}"
  }
}

path_fmt() {
  case "$1" in
    "/")
      printf "${fmt_sever}%s${fmt_reset}\n" "\\"
    ;;
    "/"*)
      printf \
        "${fmt_sever}%s${fmt_reset}${fmt_mute}\\%s${fmt_reset}\n" "${1##*/}" "$(path_rev "${1%/*}")"
    ;;
    *)
      printf "${fmt_sever}%s${fmt_reset}\n" "$1"
    ;;
  esac
}

IFS="$NL"
df -P -k | tail -n "+2" | tr -s " " ";" | sort -t ";" -k "6" | while read -r "line"; do
  IFS=";"
  # shellcheck disable=SC2086
  set -- $line
  IFS="$IFS_"

  if [ -z "$opt_f" ]; then
    case "$1" in
      "none"|"tmpfs"|"efivarfs"|"dev"|*".appimage")
        continue
      ;;
      "run")
        case "$6" in
          "/run/media/"*)
          ;;
          *)
            continue
          ;;
        esac
      ;;
      *)
        case "$6" in
          "/boot"|"/System/Volumes/"*)
            continue
          ;;
        esac
      ;;
    esac
  fi

  free_pcnt="$((($4 * 100) / $2))"

  fmt_sever="\x1b[0;32m"
  sym_sever=""

  if [ "$free_pcnt" -lt "10" ]; then
    fmt_sever="\x1b[0;31m"
    sym_sever="!"
  elif [ "$free_pcnt" -lt "40" ]; then
    fmt_sever="\x1b[0;33m"
    sym_sever="~"
  fi

  printf \
    "%s ${fmt_sever}%s%%%s %s${fmt_reset}${fmt_mute}\\%s (%s)${fmt_reset}\n" \
    "$(path_fmt "$6")" "$free_pcnt" "$sym_sever" "$(human "$4")" "$(human "$2")" "$(path_rev "$1")"
done
IFS="$IFS_"
