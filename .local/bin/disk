#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

help_info() {
  script="$(basename "$0")"

  echo "NAME
    ${script} - Show disk utilization.

SYNOPSIS
    ${script} [-f]

DESCRIPTION
    Shows disk utilization.

    -f
        Shows utilization for all devices (including all of the 'tmpfs', 'efivarf', 'run', 'dev').

    -h
        Prints this message."
}

opt_f=""
while getopts "fh" "name"; do
  case "$name" in
    "f")
      opt_f="1"
    ;;
    "h")
      help_info
      exit
    ;;
    "?")
      help_info 1>&2
      exit "2"
    ;;
  esac
done

export LC_ALL="C"

fmt_reset="\x1b[0m" fmt_sever="\x1b[0;32m" fmt_mute="\x1b[0;90m"

IFS=""
df -P -k | tail -n "+2" | tr -s " " ";" | sort -t ";" -k "6" | while read -r "line"; do
  IFS=";"
  # shellcheck disable=SC2086
  set -- $line
  IFS="$IFS_"

  if [ -z "$opt_f" ]; then
    case "$1" in
      "none"|"tmpfs"|"efivarfs"|"dev"|*".appimage")
        continue
      ;;
      "run")
        case "$6" in
          "/run/media/"*)
          ;;
          *)
            continue
          ;;
        esac
      ;;
      *)
        case "$6" in
          "/boot"|"/System/Volumes/"*)
            continue
          ;;
        esac
      ;;
    esac
  fi

  free_pcnt="$((($4 * 100) / $2))"

  fmt_sever="\x1b[0;32m"
  sym_sever=""

  if [ "$free_pcnt" -lt "10" ]; then
    fmt_sever="\x1b[0;31m"
    sym_sever="!"
  elif [ "$free_pcnt" -lt "40" ]; then
    fmt_sever="\x1b[0;33m"
    sym_sever="~"
  fi

  human_free=""
  human_total=""
  for size in "f" "t"; do
    case "$size" in
      "f")
        var="$4"
      ;;
      "t")
        var="$2"
      ;;
    esac

    scl="$((
      var < 1024 ? 1 :
        var < 1048576 ? 1024 :
          var < 1073741824 ? 1048576 :
            var < 1099511627776 ? 1073741824 :
              var < 1125899906842624 ? 1099511627776 :
                0
    ))"

    case "$scl" in
      "1") unit="K" ;;
      "1024") unit="M" ;;
      "1048576") unit="G" ;;
      "1073741824") unit="T" ;;
      "1099511627776") unit="P" ;;
    esac

    ans="$(((var * 10) / scl))"
    ans="${ans%[0-9]}.${ans#"${ans%[0-9]}"}"
    ans="${ans%.0}${unit}"

    case "$size" in
      "f")
        human_free="$ans"
      ;;
      "t")
        human_total="$ans"
      ;;
    esac
  done

  path_mpt_rev=""
  path_dev_rev=""

  for p in "m" "d"; do
    case "$p" in
      "m")
        var="$6"
      ;;
      "d")
        var="$1"
      ;;
    esac

    fp="$var" suf_rev=""

    case "$var" in
      "//"*"/"*) # SMB //<host>/ in //<host>/<path>
        fp="${var#"//"*"/"}"

        suf="${var%"$fp"}"
        suf="${suf#"//"}"
        suf="${suf%"/"}"

        suf_rev=""

        tmp="$suf"
        while [ "$tmp" ]; do
          rest="${tmp#?}"
          first="${tmp%"$rest"}"

          suf_rev="${suf_rev}${first}"

          if [ "$first" = "." ]; then
            suf_rev="${suf_rev}${NL}"
          fi

          tmp="$rest"
        done

        tmp=""
        IFS="$NL"
        for i in $suf_rev; do
          IFS="$IFS_"
          case "$i" in
            *".")
              tmp=".${i%%.}${tmp}"
            ;;
            *)
              tmp="${i}${tmp}"
            ;;
          esac
        done
        IFS="$IFS_"

        suf_rev="\\$tmp\\\\"
      ;;
      *"@"*":/"*) # SSFHS: <user>@<host>:/ in <user>@<host>:/<path>
        fp="${1#*"@"*":"}"
        suf="${1%":${fp}"}"

        suf_rev=""

        tmp="$suf"
        while [ "$tmp" ]; do
          rest="${tmp#?}"
          first="${tmp%"$rest"}"

          suf_rev="${suf_rev}${first}"

          case "$first" in
            "."|"@")
              suf_rev="${suf_rev}${NL}"
            ;;
          esac

          tmp="$rest"
        done

        tmp=""
        IFS="$NL"
        for i in $suf_rev; do
          IFS="$IFS_"

          case "$i" in
            *".")
              tmp=".${i%%.}${tmp}"
            ;;
            *"@")
              tmp="@${i%%@}${tmp}"
            ;;
            *)
              tmp="${i}${tmp}"
            ;;
          esac
        done
        IFS="$IFS_"

        suf_rev=":${tmp}"
      ;;
    esac

    fp_nl=""
    tmp="$fp"
    while [ "$tmp" ]; do
      rest="${tmp#?}"
      first="${tmp%"$rest"}"
      if [ "$first" = "/" ]; then
        fp_nl="${fp_nl}${first}${NL}"
      else
        fp_nl="${fp_nl}${first}"
      fi
      tmp="$rest"
    done

    rev=""
    IFS="$NL"
    for i in $fp_nl; do
      IFS="$IFS_"

      case "$i" in
        "/")
          rev="\\${rev}"
        ;;
        *"/")
          rev="\\${i%%/}${rev}"
        ;;
        *)
          rev="${i}${rev}"
        ;;
      esac
    done
    IFS="$IFS_"

    case "$p" in
      "m")
        path_mpt_rev="${rev}${suf_rev}"
      ;;
      "d")
        path_dev_rev="${rev}${suf_rev}"
      ;;
    esac
  done

  path_mpt_rev_name="$path_mpt_rev"
  path_mpt_rev_path=""

  case "$path_mpt_rev" in
    "\\")
    ;;
    *"\\")
      path_mpt_rev_name="${path_mpt_rev%%\\*}"
      path_mpt_rev_path="\\${path_mpt_rev#*\\}"
    ;;
  esac

  printf \
    "${fmt_sever}%s${fmt_reset}${fmt_mute}%s${fmt_reset} ${fmt_sever}%s%%%s %s${fmt_reset}${fmt_mute}\\%s (%s)${fmt_reset}\n" \
    "$path_mpt_rev_name" "$path_mpt_rev_path" "$free_pcnt" "$sym_sever" "$human_free" "$human_total" "$path_dev_rev"
done
IFS="$IFS_"
