#!/usr/bin/env sh
set -euf
NL="
"

delay_current=""
path_state="${XDG_STATE_HOME-"${HOME}/.local/state"}/screencapture_menu_desktop"
path_state_delay="${path_state}/delay"
path_state_previous_choice="${path_state}/previous_choice"
delay_current_str=""

if [ -f "$path_state_delay" ]; then
  delay_current="$(head < "$path_state_delay")"

  if [ "$delay_current" != "0" ]; then
    delay_current_str="${delay_current:+" (${delay_current}s)"}"
  fi
else
  mkdir -p "$path_state"
fi

if [ -f "$path_state_previous_choice" ]; then
  previous_choice="$(head < "$path_state_previous_choice")"
else
  mkdir -p "$path_state"
fi

lines="Capture: all screens
Capture: current screen
Capture: current window
Capture: current workspace
Capture: area selection
Capture: screen selection
Capture: window selection
Capture: workspace selection
Record: all screens
Record: current screen
Record: current window
Record: current workspace
Record: area selection
Record: screen selection
Record: window selection
Record: workspace selection
Set delay${delay_current_str}
Cancel"

options="capture all
capture output_focused
capture window_focused
capture workspace_focused
capture area
capture output
capture window
capture workspace
record all
record output_focused
record window_focused
record workspace_focused
record area
record output
record window
record workspace
set_delay
cancel"

if [ "$previous_choice" ]; then
  case "$previous_choice" in
    "Capture: "*|"Record: "*)
      if ! echo "$lines" | grep -q -x "$previous_choice"; then
        mkdir -p "$path_state"
        echo > "$path_state_previous_choice"
      else
        previous_choice_idx="$(echo "$lines" | grep -n -x "$previous_choice" | cut -f"1" -d":")"
        previous_choice_option="$(echo "$options" | sed "${previous_choice_idx}q;d")"

        lines="${previous_choice}${NL}$(echo "$lines" | grep -v -x "$previous_choice")"
        options="${previous_choice_option}${NL}$(echo "$options" | grep -v -x "$previous_choice_option")"
      fi
    ;;
    *)
      mkdir -p "$path_state"
      echo > "$path_state_previous_choice"
    ;;
  esac
fi

sel_line="$(printf "%s\n" "$lines" | menu_desktop -p "Action${delay_current_str}:")"

sel_idx="$(echo "$lines" | grep -n -x "$sel_line" | cut -f"1" -d":")"

if [ -z "$sel_idx" ]; then
  exit "1"
fi

sel_option="$(echo "$options" | sed "${sel_idx}q;d")"

case "$sel_option" in
  "set_delay")
    options_delay="0${NL}3${NL}5${NL}10${NL}15${NL}30${NL}Cancel"

    sel_line="$(
      set +e
      printf "%s\n" "$options_delay" | menu_desktop -p "Delay in seconds${delay_current_str}:"
      set -e
    )"

    case "$sel_line" in
      ''|*[!0123456789]*)
        exec screencapture_menu_desktop
      ;;
      *)
        echo "$sel_line" > "$path_state_delay"
        exec screencapture_menu_desktop
      ;;
    esac
  ;;
  "cancel")
    exit
  ;;
  *)
    mkdir -p "$path_state"
    echo "$sel_line" > "$path_state_previous_choice"

    # shellcheck disable=SC2086
    screencapture $sel_option "$delay_current"
  ;;
esac
