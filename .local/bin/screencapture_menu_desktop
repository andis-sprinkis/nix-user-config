#!/usr/bin/env sh
set -euf
NL="
"

path_state="${XDG_STATE_HOME-"${HOME}/.local/state"}/screencapture_menu_desktop"

if [ ! -d "$path_state" ]; then mkdir -p "$path_state"; fi

path_state_action="${path_state}/action"
path_state_target="${path_state}/target"
path_state_delay="${path_state}/delay"
path_state_audio="${path_state}/audio"

if [ -f "$path_state_action" ]; then action="$(head < "$path_state_action")"; else action="capture"; fi
if [ -f "$path_state_target" ]; then target="$(head < "$path_state_target")"; else target="area"; fi
if [ -f "$path_state_delay" ]; then delay="$(head < "$path_state_delay")"; else delay="0"; fi
if [ -f "$path_state_audio" ]; then audio="$(head < "$path_state_audio")"; else audio="false"; fi

sel_option=""

if [ "${1:-""}" = "silent" ]; then
  if [ "$action" = "capture" ]; then sel_option="start"; fi
else
  lines="Start${NL}action: ${action}${NL}delay: ${delay}${NL}target: ${target}${NL}audio: ${audio}${NL}Exit"
  options="start${NL}action${NL}delay${NL}target${NL}audio${NL}exit"

  sel_line="$(echo "$lines" | menu_desktop -p "Screen capture:")"
  sel_idx="$(echo "$lines" | grep -n -x "$sel_line" | cut -f"1" -d":")"

  if [ -z "$sel_idx" ]; then exit "1"; fi

  sel_option="$(echo "$options" | sed -e "${sel_idx}q;d")"
fi

case "$sel_option" in
  "start")
    exec screencapture -a "$action" -t "$target" -d "$delay" -i "$audio"
  ;;
  "exit")
    exit
  ;;
  "action")
    sel="$(set +e; echo "capture${NL}record${NL}Cancel" | menu_desktop -p "action (${action}):"; set -e)"

    case "$sel" in
      "capture"|"record_start")
        echo "$sel" > "$path_state_action"
      ;;
    esac
  ;;
  "target")
    sel="$(set +e; echo "area${NL}window_focused${NL}workspace_focused${NL}output_focused${NL}window${NL}workspace${NL}output${NL}all${NL}Cancel" | menu_desktop -p "target (${target}):"; set -e)"

    case "$sel" in
      "area"|"window_focused"|"workspace_focused"|"output_focused"|"window"|"workspace"|"output"|"all")
        echo "$sel" > "$path_state_target"
      ;;
    esac
  ;;
  "audio")
    sel="$(set +e; echo "false${NL}true${NL}Cancel" | menu_desktop -p "audio (${audio}):"; set -e)"

    case "$sel" in
      "false"|"true")
        echo "$sel" > "$path_state_audio"
      ;;
    esac
  ;;
  "delay")
    sel="$(set +e; echo "0${NL}3${NL}5${NL}10${NL}15${NL}30${NL}Cancel" | menu_desktop -p "delay (${delay}):"; set -e)"

    case "$sel" in
      ''|*[!0123456789]*)
      ;;
      *)
        echo "$sel" > "$path_state_delay"
      ;;
    esac
  ;;
esac

exec screencapture_menu_desktop
