#!/usr/bin/env sh
set -euf
NL="
"

path_state="${XDG_STATE_HOME-"${HOME}/.local/state"}/screencapture_menu_desktop"

if [ ! -d "$path_state" ]; then mkdir -p "$path_state"; fi

delay_current=""
path_state_delay="${path_state}/delay"
path_state_audio="${path_state}/audio"
path_state_previous_choice="${path_state}/previous_choice"

delay_current_str=""

if [ -f "$path_state_delay" ]; then delay_current="$(head < "$path_state_delay")"; fi

delay_current_str="${delay_current:+" (${delay_current:-"0"}s)"}"

audio_current=""
audio_current_str=""

if [ -f "$path_state_audio" ]; then audio_current="$(head < "$path_state_audio")"; fi

audio_current_str=" (${audio_current:-"false"})"

if [ -f "$path_state_previous_choice" ]; then
  previous_choice="$(head < "$path_state_previous_choice")"
fi

lines="Capture: all screens
Capture: current screen
Capture: current window
Capture: current workspace
Capture: area selection
Capture: screen selection
Capture: window selection
Capture: workspace selection
Record: all screens
Record: current screen
Record: current window
Record: current workspace
Record: area selection
Record: screen selection
Record: window selection
Record: workspace selection
Audio${audio_current_str}
Delay${delay_current_str}
Exit"

options="-a capture -t all
-a capture -t output_focused
-a capture -t window_focused
-a capture -t workspace_focused
-a capture -t area
-a capture -t output
-a capture -t window
-a capture -t workspace
-a record_start -t all
-a record_start -t output_focused
-a record_start -t window_focused
-a record_start -t workspace_focused
-a record_start -t area
-a record_start -t output
-a record_start -t window
-a record_start -t workspace
set_audio
set_delay
exit"

if [ "$previous_choice" ]; then
  case "$previous_choice" in
    "Capture: "*|"Record: "*)
      if ! printf '%s\n' "$lines" | grep -q -v -e "^.${previous_choice}.$"; then
        mkdir -p "$path_state"
        echo > "$path_state_previous_choice"
      else
        previous_choice_idx="$(printf '%s\n' "$lines" | grep -n -x "$previous_choice" | cut -f"1" -d":")"
        previous_choice_option="$(printf '%s\n' "$options" | sed "${previous_choice_idx}q;d")"

        lines="${previous_choice}${NL}$(printf '%s\n' "$lines" | grep -v -e "^.${previous_choice}.$")"
        options="${previous_choice_option}${NL}$(printf '%s\n' "$options" | grep -v -e "^.${previous_choice_option}.$")"
      fi
    ;;
    *)
      mkdir -p "$path_state"
      echo > "$path_state_previous_choice"
    ;;
  esac
fi

sel_line="$(printf "%s\n" "$lines" | menu_desktop -p "Action${delay_current_str}:")"

sel_idx="$(printf '%s\n' "$lines" | grep -n -x "$sel_line" | cut -f"1" -d":")"

if [ -z "$sel_idx" ]; then
  exit "1"
fi

sel_option="$(printf '%s\n' "$options" | sed "${sel_idx}q;d")"

case "$sel_option" in
  "set_delay")
    options_delay="0${NL}3${NL}5${NL}10${NL}15${NL}30${NL}Cancel"

    sel_line="$(
      set +e
      printf "%s\n" "$options_delay" | menu_desktop -p "Delay in seconds${delay_current_str}:"
      set -e
    )"

    case "$sel_line" in
      ''|*[!0123456789]*)
        exec screencapture_menu_desktop
      ;;
      *)
        printf '%s\n' "$sel_line" > "$path_state_delay"
        exec screencapture_menu_desktop
      ;;
    esac
  ;;
  "set_audio")
    options_audio="false${NL}true${NL}Cancel"

    sel_line="$(
      set +e
      printf "%s\n" "$options_audio" | menu_desktop -p "Audio${audio_current_str}:"
      set -e
    )"

    case "$sel_line" in
      "false"|"true")
        printf '%s\n' "$sel_line" > "$path_state_audio"
        exec screencapture_menu_desktop
      ;;
      *)
        exec screencapture_menu_desktop
      ;;
    esac
  ;;
  "exit")
    exit
  ;;
  *)
    mkdir -p "$path_state"
    printf '%s\n' "$sel_line" > "$path_state_previous_choice"

    # shellcheck disable=SC2086
    screencapture $sel_option -d "$delay_current" -i "$audio_current"
  ;;
esac
