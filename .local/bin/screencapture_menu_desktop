#!/usr/bin/env sh
set -euf
NL="
"

delay_current=""
path_state="${XDG_STATE_HOME-"${HOME}/.local/state"}/screencapture_menu_desktop"
path_state_delay="${path_state}/delay"
path_state_previous_choice="${path_state}/previous_choice"
delay_current_str=""

if [ -f "$path_state_delay" ]; then
  delay_current="$(head < "$path_state_delay")"

  if [ "$delay_current" != "0" ]; then
    delay_current_str="${delay_current:+" (${delay_current}s)"}"
  fi
else
  mkdir -p "$path_state"
fi

if [ -f "$path_state_previous_choice" ]; then
  previous_choice="$(head < "$path_state_previous_choice")"
else
  mkdir -p "$path_state"
fi

lines="Picture: all screens
Picture: current screen
Picture: current window
Picture: current workspace
Picture: area selection...
Picture: screen selection...
Picture: window selection...
Picture: workspace selection...
Video: all screens
Video: current screen
Video: current window
Video: current workspace
Video: area selection...
Video: screen selection...
Video: window selection...
Video: workspace selection...
Delay${delay_current_str}"

options="picture all
picture output_focused
picture window_focused
picture workspace_focused
picture area
picture output
picture window
picture workspace
video all
video output_focused
video window_focused
video workspace_focused
video area
video output
video window
video workspace
set_delay"

if [ "$previous_choice" ]; then
  case "$previous_choice" in
    "Picture: "*|"Video: "*)
      if ! echo "$lines" | grep -q -x "$previous_choice"; then
        mkdir -p "$path_state"
        echo > "$path_state_previous_choice"
      else
        previous_choice_idx="$(echo "$lines" | grep -n -x "$previous_choice" | cut -f"1" -d":")"
        previous_choice_option="$(echo "$options" | sed "${previous_choice_idx}q;d")"

        lines="${previous_choice}${NL}$(echo "$lines" | grep -v -x "$previous_choice")"
        options="${previous_choice_option}${NL}$(echo "$options" | grep -v -x "$previous_choice_option")"
      fi
    ;;
    *)
      mkdir -p "$path_state"
      echo > "$path_state_previous_choice"
    ;;
  esac
fi

sel_line="$(printf "%s\n" "$lines" | menu_desktop -p "Capture${delay_current_str}:")"

sel_idx="$(echo "$lines" | grep -n -x "$sel_line" | cut -f"1" -d":")"

if [ -z "$sel_idx" ]; then
  exit "1"
fi

sel_option="$(echo "$options" | sed "${sel_idx}q;d")"

case "$sel_option" in
  "set_delay")
    options_delay="0${NL}3${NL}5${NL}10${NL}15${NL}30"

    sel_line="$(
      set +e
      printf "%s\n" "$options_delay" | menu_desktop -p "Delay in seconds${delay_current_str}:"
      set -e
    )"

    case "$sel_line" in
      ''|*[!0123456789]*)
        exec screencapture_menu_desktop
      ;;
      *)
        echo "$sel_line" > "$path_state_delay"
        exec screencapture_menu_desktop
      ;;
    esac
  ;;
  *)
    mkdir -p "$path_state"
    echo "$sel_line" > "$path_state_previous_choice"

    # shellcheck disable=SC2086
    screencapture $sel_option "$delay_current"
  ;;
esac
