#!/usr/bin/env sh
set -euf

if systemctl is-active --quiet "sshd"; then
  exec $TERMINAL -e "/usr/bin/env" "sh" "-c" "printf \"\033]0;%s\007\" \"Stop SSHD service\"; systemctl stop sshd; read"
fi

exec $TERMINAL -e "/usr/bin/env" "sh" "-c" "printf \"\033]0;%s\007\" \"Start SSHD service\"; systemctl start sshd; read"
