#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

open_with_cmd() {
  cmd="$1"

  set --

  IFS=" "
  for arg in $cmd; do
    IFS="$IFS_"

    set -- "$@" "$arg"
  done
  IFS="$IFS_"

  IFS="$NL"
  # shellcheck disable=SC3044
  for f in $file_list; do
    IFS="$IFS_"

    env "$@" "$f" 1> "/dev/null" 2> "/dev/null" & disown
  done
  IFS="$IFS_"
}

open_with_cmd_terminal() {
  IFS="$NL"
  # shellcheck disable=SC3044
  for f in $file_list; do
    IFS="$IFS_"

    terminal_shell_cmd "exec_wait" "$1" "$f" 1> "/dev/null" 2> "/dev/null" & disown
  done
  IFS="$IFS_"
}

cmd_args="$(
  j4-dmenu-desktop \
  --no-generic \
  --skip-i3-exec-check \
  --display-binary \
  --term-mode="custom" \
  --term="${TERMINAL} -e {cmdline@}" \
  --dmenu="(cat; (stest -flx \$(echo \$PATH | tr : ' ') | sort -u)) | menu_desktop -p 'Open with:'" \
  --no-exec \
  2> "/dev/null"
)"

if [ -z "$cmd_args" ]; then exit "0"; fi

file_list=""

if [ "$#" -eq "0" ]; then
  while read -r file; do
    if [ "$file" ]; then file_list="${file_list}${file_list:+"$NL"}${file}"; fi
  done
else
  while [ "$#" -gt "0" ]; do
    if [ "$1" ]; then file_list="${file_list}${file_list:+"$NL"}${1}"; fi
    shift
  done
fi

if [ -z "$file_list" ]; then exit "1"; fi

cmd=""

IFS=" "
for arg in $cmd_args; do
  IFS="$IFS_"

  tmp="$arg"
  tmp="${tmp#"'"}"
  tmp="${tmp%"'"}"
  cmd="${cmd:+"$cmd "}${tmp}"
done
IFS="$IFS_"

case "$cmd" in
  "${TERMINAL} -e "*)
    open_with_cmd "$cmd"
  ;;
  *"."[aA][pP][pP][iI][mM][aA][gG][eE])
    open_with_cmd "${cmd#"/bin/sh -c "}"
  ;;
  "/bin/sh -c "*)
    open_with_cmd_terminal "${cmd#"/bin/sh -c "}"
  ;;
  *)
    open_with_cmd "$cmd"
  ;;
esac
