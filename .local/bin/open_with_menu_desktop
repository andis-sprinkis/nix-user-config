#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

file_list=""
cmd=""

open_with_cmd() {
  IFS="$NL"
  for f in $file_list; do
    IFS="$IFS_"
    $cmd "$f" 1> "/dev/null" 2> "/dev/null" & disown
  done
  IFS="$IFS_"

  exit "0"
}

open_with_cmd_terminal() {
  IFS="$NL"
  for f in $file_list; do
    IFS="$IFS_"

    terminal_shell_cmd "exec_wait" "$cmd" "$f" 1> "/dev/null" 2> "/dev/null" & disown
  done
  IFS="$IFS_"

  exit "0"
}

cmd_args="$(
  j4-dmenu-desktop \
  --no-generic \
  --skip-i3-exec-check \
  --display-binary \
  --term-mode="custom" \
  --term="${TERMINAL} -e {cmdline@}" \
  --dmenu="(cat; (stest -flx \$(echo \$PATH | tr : ' ') | sort -u)) | menu_desktop -p 'Open with:'" \
  --no-exec \
  2> "/dev/null"
)"

if [ -z "$cmd_args" ]; then exit "0"; fi

if [ "$#" -eq "0" ]; then
  while read file; do
    if [ "$file" ]; then file_list="${file_list:+"${file_list}${NL}"}${file}"; fi
  done
else
  while [ "$#" -gt "0" ]; do
    if [ "$1" ]; then file_list="${file_list:+"${file_list}${NL}"}${1}"; fi
    shift
  done
fi

if [ -z "$file_list" ]; then exit "1"; fi

IFS=" "
for a in $cmd_args; do
  IFS="$IFS_"

  arg="$a"
  arg="${arg#"'"}"
  arg="${arg%"'"}"
  cmd="${cmd:+"$cmd "}${arg}"
done
IFS="$IFS_"

case "$cmd" in
  *"."[aA][pP][pP][iI][mM][aA][gG][eE])
    cmd="${cmd#"/bin/sh -c "}"
    open_with_cmd
  ;;
  "${TERMINAL} -e "*)
    open_with_cmd
  ;;
  *)
    cmd="${cmd#"/bin/sh -c "}"
    open_with_cmd_terminal
  ;;
esac
