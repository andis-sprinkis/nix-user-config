#!/usr/bin/env sh
set -euf
NL="
"

msg_paused="Media paused${NL}Media paused"
msg_playing="Media playing${NL}Media playing"
msg_stopped="Media stopped${NL}Media stopped"

case "$(set +e; playerctl status 2> "/dev/null"; set -e)" in
  "Playing")
    if [ "${BLOCK_BUTTON:-""}" ]; then
      # shellcheck disable=SC3044
      case "$BLOCK_BUTTON" in
        "1")
           playerctl pause 1> "/dev/null" 2> "/dev/null" & disown
           exec echo "$msg_paused"
        ;;
        "2")
          "${XDG_DATA_HOME:-$HOME/.local/share}/i3/new_workspace" 1> "/dev/null" 2> "/dev/null" & disown
        ;;
        "3")
           playerctl stop 1> "/dev/null" 2> "/dev/null" & disown
           exec echo "$msg_stopped"
        ;;
        "4")
           playerctl position "5+" 1> "/dev/null" 2> "/dev/null" & disown
        ;;
        "5")
           playerctl position "5-" 1> "/dev/null" 2> "/dev/null" & disown
        ;;
      esac
    fi

    exec echo "$msg_playing"
  ;;
  "Paused")
    if [ "${BLOCK_BUTTON:-""}" ]; then
      # shellcheck disable=SC3044
      case $BLOCK_BUTTON in
        "1")
           playerctl play 1> "/dev/null" 2> "/dev/null" & disown
           exec echo "$msg_playing"
        ;;
        "3")
           playerctl stop 1> "/dev/null" 2> "/dev/null" & disown
           exec echo "$msg_stopped"
        ;;
      esac
    fi

    exec echo "$msg_paused"
  ;;
  "Stopped")
    if [ "${BLOCK_BUTTON:-""}" ]; then
      # shellcheck disable=SC3044
      case $BLOCK_BUTTON in
        "1"|"3")
          playerctl play 1> "/dev/null" 2> "/dev/null" & disown
          exec echo "$msg_playing"
        ;;
      esac
    fi

    exec echo "$msg_stopped"
  ;;
esac
