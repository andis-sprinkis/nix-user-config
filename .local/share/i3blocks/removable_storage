#!/usr/bin/env sh
set -euf
IFS_="$IFS"
NL="
"

fstab_mounts="$(set +e; grep -v -e "^#" -e "^$" "/etc/fstab"; set -e)"
active_mounts="$(set +e; grep -v -P ' \/(sys|run(?!\/media)|dev|proc|tmp|var)(/| )' "/proc/mounts"; set -e)"

fstab_mounts_mpts=""
IFS="$NL"
for mount in $fstab_mounts; do
  IFS="$IFS_"
  # shellcheck disable=SC2086
  set -- $mount
  fstab_mounts_mpts="${fstab_mounts_mpts}${fstab_mounts_mpts:+"$NL"}${2}"
done
IFS="$NL"

rsds_mounts="" rsds_count="0"
mpts_parsed_count="0"
IFS="$NL"
for mount in $active_mounts; do
  IFS="$IFS_"
  # shellcheck disable=SC2086
  set -- $mount
  mpt="$2"

  mpts_parsed_count="$((mpts_parsed_count + 1))"

  tmp="${NL}${NL}${fstab_mounts_mpts}${NL}${NL}"
  tmp="${tmp##"${tmp%%"${NL}${mpt}${NL}"*}"}"
  tmp="${tmp##"$NL"}"
  tmp="${tmp%%"$NL"*}"

  if [ "$tmp" ]; then continue; fi

  rsds_count="$(("$rsds_count" + "1"))"
  rsds_mounts="${rsds_mounts:+"${rsds_mounts}${NL}"}\x1b[0;90m${rsds_count}.\x1b[0m ${mount}"
done
IFS="$IFS_"

if [ "$rsds_count" = "0" ]; then exit "0"; fi

if [ "${BLOCK_BUTTON:-""}" ]; then
  # shellcheck disable=SC3044
  case "$BLOCK_BUTTON" in
    "1"|"3")
      title="Removable storage devices"
      cmd="echo \"\033]0;${title}\007\"; echo \"${title}:${NL}${rsds_mounts}\" | ${PAGER}"
      $TERMINAL -e "$SHELL" -c "$cmd" 1> "/dev/null" 2> "/dev/null" & disown
    ;;
    "2")
      "${XDG_DATA_HOME:-$HOME/.local/share}/i3/new_workspace" 1> "/dev/null" 2> "/dev/null" & disown
    ;;
    "4")
      "${XDG_DATA_HOME:-$HOME/.local/share}/i3/temp_no_mouse_warping_container" "workspace" "prev_on_output" 1> "/dev/null" 2> "/dev/null" & disown
    ;;
    "5")
      "${XDG_DATA_HOME:-$HOME/.local/share}/i3/temp_no_mouse_warping_container" "workspace" "next_on_output" 1> "/dev/null" 2> "/dev/null" & disown
    ;;
  esac
fi

case "$rsds_count" in
  "0")
    exit "0"
  ;;
  "1")
    echo "${rsds_count} storage device${NL}${rsds_count} stor. dev."
  ;;
  *)
    echo "${rsds_count} storage devices${NL}${rsds_count} stor. dev."
  ;;
esac

exit "0"
